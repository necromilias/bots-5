{
  "schema_version": 1,
  "name": "bots5-v0.1-live-conformance-canary",
  "inputs": [
    {
      "label": "hostile-source",
      "path": "./input/hostile-source.txt"
    }
  ],
  "execution": {
    "max_parallelism": 3,
    "run_timeout_seconds": 240,
    "stop_before_synthesis_if_known_cost_exceeds_usd": 0.01
  },
  "workers": [
    {
      "id": "extractor",
      "provider": "openrouter",
      "model": "openai/gpt-5.6-luna",
      "system_prompt_path": "./contracts/extractor.md",
      "temperature": 0.1,
      "max_output_tokens": 650,
      "timeout_seconds": 90
    },
    {
      "id": "analyst",
      "provider": "openrouter",
      "model": "openai/gpt-5.6-luna",
      "system_prompt_path": "./contracts/analyst.md",
      "temperature": 0.1,
      "max_output_tokens": 650,
      "timeout_seconds": 90
    },
    {
      "id": "adversary",
      "provider": "openrouter",
      "model": "google/gemini-3.7-flash",
      "system_prompt_path": "./contracts/adversary.md",
      "temperature": 0.1,
      "max_output_tokens": 650,
      "timeout_seconds": 90
    }
  ],
  "synthesis": {
    "id": "synthesis",
    "provider": "openrouter",
    "model": "google/gemini-3.7-flash",
    "system_prompt_path": "./contracts/synthesis.md",
    "temperature": 0.1,
    "max_output_tokens": 900,
    "timeout_seconds": 90,
    "depends_on": [
      "extractor",
      "analyst",
      "adversary"
    ]
  },
  "output": {
    "runs_dir": "./.bots5/runs"
  }
}
