{
  "schema_version": 1,
  "name": "bots5-smoke-example",
  "inputs": [
    {
      "label": "source",
      "path": "./input/source.txt"
    }
  ],
  "execution": {
    "max_parallelism": 3,
    "run_timeout_seconds": 900,
    "stop_before_synthesis_if_known_cost_exceeds_usd": 2.0
  },
  "workers": [
    {
      "id": "extractor",
      "provider": "openrouter",
      "model": "openai/gpt-5.6-luna",
      "system_prompt_path": "./prompts/extractor.md",
      "temperature": 0.1,
      "max_output_tokens": 5000,
      "timeout_seconds": 300
    },
    {
      "id": "analyst",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-pro-0813",
      "system_prompt_path": "./prompts/analyst.md",
      "temperature": 0.1,
      "max_output_tokens": 5000,
      "timeout_seconds": 300
    },
    {
      "id": "adversary",
      "provider": "openrouter",
      "model": "google/gemini-3.7-flash",
      "system_prompt_path": "./prompts/adversary.md",
      "temperature": 0.1,
      "max_output_tokens": 5000,
      "timeout_seconds": 300
    }
  ],
  "synthesis": {
    "id": "synthesis",
    "provider": "openrouter",
    "model": "z-ai/glm-5.3",
    "system_prompt_path": "./prompts/synthesis.md",
    "temperature": 0.1,
    "max_output_tokens": 5000,
    "timeout_seconds": 300,
    "depends_on": [
      "extractor",
      "analyst",
      "adversary"
    ]
  },
  "output": {
    "runs_dir": "./.bots5/runs"
  }
}
